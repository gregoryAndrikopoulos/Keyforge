    "@vitejs/plugin-react-swc": "^4.3.2",
    "@wdio/cli": "^9.30.0",
    "@wdio/devtools-service": "10.8.0",
    "@wdio/globals": "9.29.1",
    "@wdio/local-runner": "^9.30.0",
